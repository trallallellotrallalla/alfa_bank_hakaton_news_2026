# ---------- База данных ----------
# PostgreSQL 15+ с расширением pgvector >= 0.5 (образ pgvector/pgvector:pg16).
# Пользователю нужны права CREATE SCHEMA и CREATE EXTENSION vector
# (или расширение должен заранее создать админ: CREATE EXTENSION vector;).
DATABASE_URL=postgresql+psycopg://news:news@db:5432/news
# Все таблицы модуля news-parser лежат в этой схеме — не пересекаются с другими модулями
DB_SCHEMA=news

# ---------- LLM (API организаторов кейса, OpenAI-совместимый) ----------
# Единые переменные для news-parser (LLM_API_URL) и interpreter (LLM_BASE_URL).
LLM_API_URL=https://api.alfahack-gateway26.ru/v1
LLM_BASE_URL=https://api.alfahack-gateway26.ru/v1
# >>> СЮДА ВСТАВИТЬ КЛЮЧ <<<  Пусто — LLM в парсере выключена (разметка правилами).
LLM_API_KEY=
# ID модели строго из списка разрешённых (Приложение 3 ТЗ):
#   qwen/qwen3.6-35b-a3b, google/gemma-4-26b-a4b-it, z-ai/glm-5.3-flash,
#   deepseek/deepseek-v4.1-flash, qwen/qwen3-vl-30b-a3b-instruct, moonshotai/kimi-k2.6
LLM_MODEL=qwen/qwen3.6-35b-a3b
# response_format=json_object; включать, только если API поддерживает
LLM_JSON_MODE=false
LLM_MAX_TOKENS=2000
# Рассуждения модели перед ответом. none — выключены: без этого Qwen3.6 тратит весь лимит
# токенов на «мысли» и отдаёт пустой ответ (проверено на API кейса; «/no_think» не работает).
# Пусто — параметр не отправляется.
LLM_REASONING_EFFORT=none
# Доп. параметры запроса в JSON, отправляются как есть (обычно не нужны)
LLM_EXTRA_BODY=
# Сколько токенов в сутки модуль может потратить (ключ общий на команду!)
LLM_DAILY_TOKEN_BUDGET=300000
LLM_MAX_INPUT_CHARS=6000

# ---------- Эмбеддинги ----------
# Менять только вместе: модель и её размерность. Размерность зашивается в таблицы
# при первой миграции — после смены нужно пересоздать схему.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIM=768

# ---------- Обработка ----------
MIN_TEXT_CHARS=200
PREFILTER_REQUIRE_SIGNAL=true
CLUSTER_SIMILARITY_THRESHOLD=0.86
CLUSTER_WINDOW_HOURS=72

# Чанки статей — контекст для агента
NEWS_CHUNK_CHARS=900
NEWS_MAX_CHUNKS=12

# ---------- Подбор под профиль клиента ----------
MATCH_WINDOW_DAYS=14
MATCH_MIN_SIMILARITY=0.3
# Запасной поиск без правил, если правила пропустили меньше MATCH_MIN_NEWS новостей
# (такие новости помечаются passed_rules=false). false — строго только правила.
MATCH_FALLBACK=true
MATCH_MIN_NEWS=3
MATCH_FALLBACK_MARGIN=0.15
# База с данными клиентов (таблицы schema.sql: companies, payments, persons, person_company).
# Эти же переменные читает библиотека data_loader (get_client_info) — одна настройка на оба модуля.
# В docker compose клиентские таблицы лежат в той же базе db (схема public), отсюда значения ниже.
DB_HOST=db
DB_PORT=5432
DB_USER=news
DB_PASSWORD=news
DB_NAME=news
# Переопределить адрес базы клиентов только для news-parser (обычно не нужно)
PROFILES_DATABASE_URL=
PROFILES_DB_SCHEMA=public

# ---------- Сбор и планировщик ----------
SCHEDULER_ENABLED=true
COLLECT_INTERVAL_MIN=15
REPROCESS_INTERVAL_MIN=30
HTTP_DELAY_S=0.5

# ---------- Аналитика Альфа-Банка ----------
# Папка с PDF/TXT/MD внутри контейнера (подключается volume)
ALFA_DOCS_PATH=/data/alfa
LOAD_ANALYTICS_ON_START=true
# PDF-сканы (без текстового слоя) распознаются мультимодальной моделью: текст + графики + таблицы.
# Результат кешируется в <имя>.analysis.json рядом с PDF — повторно токены не тратятся.
ANALYTICS_VISION=true
LLM_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
ANALYTICS_VISION_WORKERS=4
# Подбор аналитики к новости: сначала документы (по тегам и выжимке), потом фрагменты в них
ANALYTICS_DOCS_PER_NEWS=2
ANALYTICS_MAX_AGE_DAYS=730

# ---------- Логи ----------
LOG_LEVEL=INFO
