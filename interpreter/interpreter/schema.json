{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "what_happened", "why_it_matters",
    "risks", "opportunities", "recommended_actions",
    "bank_view_text", "model_inference",
    "used_chunk_id", "used_signals", "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "what_happened": {"type": "string", "minLength": 10},
    "why_it_matters": {"type": "string", "minLength": 10},
    "risks": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
    "opportunities": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
    "recommended_actions": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
    "bank_view_text": {"type": "string", "minLength": 5},
    "model_inference": {"type": "string", "minLength": 10},
    "used_chunk_id": {"type": "string", "minLength": 1},
    "used_signals": {
      "type": "array",
      "items": {"enum": ["credit_dependency", "fx_exposure", "import_dependency"]},
      "uniqueItems": true
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}