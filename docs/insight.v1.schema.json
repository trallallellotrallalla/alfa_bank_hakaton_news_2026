{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alfa-hack.example/schemas/insight.v1.json",
  "title": "insight.v1",
  "description": "Ответ AI-агента по событию для конкретной компании и роли. Каждое утверждение помечено происхождением: facts — факты из первоисточников, bank_view — позиция Альфа-Банка, ai_inference — вывод AI с признаками компании.",
  "type": "object",
  "required": [
    "schema", "event_id", "run_id", "company_id", "title", "summary", "published_at", "topics",
    "relevance", "impact", "why_you", "facts", "bank_view", "ai_inference", "actions",
    "sources", "features", "confidence", "basis", "trace", "suggested_questions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "insight.v1" },
    "event_id": { "type": "string", "description": "id новостного кластера, общий для всех компаний" },
    "run_id": { "type": "string", "description": "id прогона агента; трасса — GET /trace/{run_id}" },
    "company_id": { "type": "string", "pattern": "^U[-_]\\d+$", "description": "Синтетический id клиента (SYNTHETIC_U), например U-10482 или U_176" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "published_at": { "type": "string", "format": "date-time" },
    "topics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/topic" } },
    "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
    "impact": { "enum": ["risk", "opportunity", "attention", "scenario"] },
    "why_you": { "type": "string", "description": "Короткая причина персонализации («Почему вам: …»)" },
    "facts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourcedStatement" } },
    "bank_view": {
      "type": "array",
      "description": "Пусто, если у банка нет аналитики по теме — вывод AI нельзя выдавать за позицию банка",
      "items": { "$ref": "#/$defs/sourcedStatement" }
    },
    "ai_inference": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "text", "features"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["why_relevant", "consequence_risk", "consequence_opportunity"] },
          "text": { "type": "string" },
          "features": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Коды признаков компании (Feature.code)" },
          "src": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
          "product": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "publisher", "title", "url", "published_at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["regulator", "news", "bank_research", "registry", "exchange", "client_data"] },
          "publisher": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "published_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "label", "weight"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "examples": ["CL_PRODUCT_LOA_MARK", "OKVED_MAIN", "GROUP_ID"] },
          "label": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "basis": { "type": "string", "description": "Блок «На чём основан вывод?»" },
    "trace": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/traceStep" } },
    "bank_offer": {
      "type": "object",
      "required": ["title", "text", "product"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "text": { "type": "string" },
        "product": { "type": "string" }
      }
    },
    "suggested_questions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "topic": { "enum": ["rates", "fx", "commodities", "counterparty", "regulation", "trade"] },
    "role": { "enum": ["ceo", "cfo", "treasurer", "procurement"] },
    "sourcedStatement": {
      "type": "object",
      "required": ["text", "src"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "src": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Ссылки на sources[].id" }
      }
    },
    "traceStep": {
      "type": "object",
      "required": ["title", "tool", "detail", "time", "state"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "tool": { "type": "string", "description": "Вызов инструмента агента" },
        "detail": { "type": "string" },
        "time": { "type": "number", "minimum": 0, "description": "Длительность, с" },
        "state": { "enum": ["done", "retry", "running"] }
      }
    }
  }
}
